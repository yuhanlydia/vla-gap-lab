+def infer_embodiment(archive_name: str) -> str:
+    """Infer the native RoboTwin embodiment from the archive naming contract."""
+    stem = Path(archive_name).stem.lower()
+    if stem == "demo_clean" or stem.startswith("aloha-agilex_"):
+        return "aloha_agilex"
+    if stem.startswith("franka_"):
+        return "franka"
+    if stem.startswith("arx-x5_"):
+        return "arx_x5"
+    if stem.startswith("piper_"):
+        return "piper"
+    if stem.startswith("ur5_"):
+        return "ur5"
+    raise ValueError(
+        f"cannot infer RoboTwin embodiment from archive name {archive_name!r}; "
+        "pass an archive with a supported embodiment prefix"
+    )
+
+
+embodiment = infer_embodiment(archive_name)
